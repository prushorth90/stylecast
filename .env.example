# Copy this file to ".env" and adjust values for your local environment.
# Never commit a real ".env" file - it is ignored by .gitignore.

# --- PostgreSQL / backend datasource --------------------------------------
DB_NAME=stylecast
DB_USER=stylecast
DB_PASSWORD=stylecast

# Host port PostgreSQL is published on (container always uses 5432 internally).
DB_PORT=5433

# --- Live retail product search (Task 4B) ----------------------------------
# Used only by the temporary development endpoint
# POST /api/dev/retail-products/search, which the application does not call
# on its own yet. The app starts and runs normally without this set; calls to
# that endpoint will return HTTP 503 until a real key is provided here.
# Get a key from https://platform.openai.com/api-keys - never commit a real
# value.
OPENAI_API_KEY=

# Optional model overrides for the two OpenAI-backed features (live
# Nordstrom search/product-detail enrichment, and occasion classification).
# Both default to gpt-4.1 (see backend/src/main/resources/application.yml)
# when unset - only set these to use a different model.
OPENAI_RETAIL_SEARCH_MODEL=gpt-4.1
OCCASION_CLASSIFIER_MODEL=gpt-4.1

# Optional timeout overrides (milliseconds) for the retail-search/product-
# detail-enrichment OpenAI calls. Defaults: connect 5000, read 60000 - a
# real web-search-enabled response can involve several internal reasoning/
# web_search_call steps before the final message, so the read timeout is
# intentionally generous.
RETAIL_SEARCH_CONNECT_TIMEOUT_MS=5000
RETAIL_SEARCH_READ_TIMEOUT_MS=60000

# --- Authentication (Task 17) -----------------------------------------------
# Whether the session cookie requires HTTPS (Secure flag). Defaults to
# false, since local/Docker Compose serve plain HTTP - a real deployment
# behind HTTPS must set this to true (a browser will not send a Secure
# cookie back over plain HTTP at all, so leaving this true locally would
# break login entirely).
SESSION_COOKIE_SECURE=false
